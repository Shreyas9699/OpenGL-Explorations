// fire_compute.comp: Optimized compute shader for particle properties calculation
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in; // Reduced from 256 for better occupancy

// Structure of Arrays
layout(std430, binding = 1) buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 2) buffer Velocities {
    vec4 velocities[];
};

layout(std430, binding = 3) buffer Temperatures {
    float temperatures[];
};

layout(std430, binding = 4) buffer SmokeAmounts {
    float smokeAmounts[];
};

layout(std430, binding = 5) buffer Lifespans {
    float lifespans[];
};

layout(std430, binding = 0) buffer FreeList {
    int count;
    int indices[];
} freelist;

layout(binding = 1, offset = 0) uniform atomic_uint activeParticleCount;

// Constants and uniforms
uniform vec3 globalForce = vec3(0, -9.8, 0);
uniform float sizeBegin;
uniform float sizeEnd;
uniform float deltaTime;
uniform float time;
uniform float buoyancy = 4.0;
uniform float airResistance = 0.12;
uniform float temperatureDecay = 180.0;
uniform float turbulenceScale = 0.8;
uniform vec3 windDirection;
uniform float windStrength;
uniform float baseVorticity = 2.5;
uniform float flickerSpeed = 3.0;

vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v) {
    const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

    vec3 i  = floor(v + dot(v, C.yyy));
    vec3 x0 = v - i + dot(i, C.xxx);

    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);

    vec3 x1 = x0 - i1 + C.xxx;
    vec3 x2 = x0 - i2 + C.yyy;
    vec3 x3 = x0 - D.yyy;

    i = mod289(i);
    vec4 p = permute(permute(permute(
                i.z + vec4(0.0, i1.z, i2.z, 1.0))
              + i.y + vec4(0.0, i1.y, i2.y, 1.0))
              + i.x + vec4(0.0, i1.x, i2.x, 1.0));

    float n_ = 0.142857142857; // 1.0/7.0
    vec3  ns = n_ * D.wyz - D.xzx;

    vec4 j = p - 49.0 * floor(p * ns.z);

    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);

    vec4 x = x_ * ns.x + ns.yyyy;
    vec4 y = y_ * ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);

    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);

    vec4 s0 = floor(b0) * 2.0 + 1.0;
    vec4 s1 = floor(b1) * 2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));

    vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);

    vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;

    vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

vec3 potential(vec3 p) {
    // Spatial offsets to decorrelate x, y, z dimensions
    const vec3 offsetA = vec3(0.0, 0.0, 0.0);
    const vec3 offsetB = vec3(31.416, 47.853, 12.793);
    const vec3 offsetC = vec3(93.112, 14.231, 67.519);

    return vec3(
        snoise(p + offsetA),
        snoise(p + offsetB),
        snoise(p + offsetC)
    );
}

vec3 curlForce(vec3 p) {
    const float e = 0.1; // Epsilon step size for finite differences
    
    vec3 dx = vec3(e, 0.0, 0.0);
    vec3 dy = vec3(0.0, e, 0.0);
    vec3 dz = vec3(0.0, 0.0, e);

    // Central difference calculation
    float x = potential(p + dy).z - potential(p - dy).z
            - potential(p + dz).y + potential(p - dz).y;

    float y = potential(p + dz).x - potential(p - dz).x
            - potential(p + dx).z + potential(p - dx).z;

    float z = potential(p + dx).y - potential(p - dx).y
            - potential(p + dy).x + potential(p - dy).x;

    return vec3(x, y, z) / (2.0 * e);
}

void updateParticle(int index) 
{
    // Lifetime management
    velocities[index].w -= deltaTime;
    if(velocities[index].w <= 0.0) 
    {
        int idx = atomicAdd(freelist.count, 1);
        freelist.indices[idx] = index;
        return;
    }
    atomicCounterIncrement(activeParticleCount);

    // Age calculations
    float age = 1.0 - (velocities[index].w / lifespans[index]);
    float tempFactor = temperatures[index] * 0.0004; // Pre-computed division

    // Physics forces
    float g = length(globalForce);
    vec3 acceleration = globalForce;
    acceleration.y += buoyancy * tempFactor * g;
    
    vec3 wind = windDirection * windStrength;
    vec2 radial = positions[index].xz;
    float convergence = 3.0;

    float scrollT = mod(time, 1000.0);
    vec3 noisePos = (positions[index].xyz * turbulenceScale) - vec3(0.0, 0.3, 0.0) * scrollT;

    vec3 curlForce = curlForce(noisePos);
    curlForce = clamp(curlForce, vec3(-2.0), vec3(2.0));

     // Temperature cooling (simplified)
    float tempCooling = temperatureDecay * deltaTime * (1.0 + age);
    float neighborHeatInfluence = 0.0;

    temperatures[index] = max(temperatures[index] - tempCooling + neighborHeatInfluence * deltaTime, 0.0);
    float heat = clamp(temperatures[index] / 1200.0, 0.0, 1.0); 

    acceleration += wind;
    acceleration.xz -= radial.x * convergence * heat;
    acceleration += curlForce * baseVorticity * heat;
    
    // Velocity integration with improved damping
    velocities[index].xyz += acceleration * deltaTime;
    velocities[index].xyz *= exp(-airResistance * deltaTime);
    positions[index].xyz += velocities[index].xyz * deltaTime;

    // Size evolution (simplified)
    float ageSquared = age * age;
    positions[index].w = mix(sizeEnd, sizeBegin, 1.0 - ageSquared);

    // Smoke generation (simplified)
    smokeAmounts[index] = smoothstep(0.5, 0.9, age) * (1.0 - tempFactor);
}

void main() 
{
    uint id = gl_GlobalInvocationID.x;
    if(id >= positions.length()) return;
    if(velocities[id].w <= 0.0) return;

    updateParticle(int(id));
}