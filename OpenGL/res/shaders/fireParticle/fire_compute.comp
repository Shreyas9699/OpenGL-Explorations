#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Structure of Arrays
layout(std430, binding = 1) buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 2) buffer Velocities {
    vec4 velocities[];
};

layout(std430, binding = 3) buffer Temperatures {
    float temperatures[];
};

layout(std430, binding = 4) buffer SmokeAmounts {
    float smokeAmounts[];
};

layout(std430, binding = 5) buffer Lifespans {
    float lifespans[];
};

layout(std430, binding = 6) buffer Densities {
    float densities[];
};

layout(std430, binding = 7) buffer Pressures {
    float pressures[];
};

layout(std430, binding = 8) buffer SmoothingLengths {
    float smoothingLengths[];
};

// Optimized spatial hashing buffers
layout(std430, binding = 9) buffer GridHash {
    uvec2 gridHash[]; // x = hash, y = particle index
};

layout(std430, binding = 10) buffer SortedIndices {
    uint sortedIndices[];
};

layout(std430, binding = 11) buffer CellStarts {
    int cellStarts[];
};

layout(std430, binding = 12) buffer CellEnds {
    int cellEnds[];
};

layout(std430, binding = 0) buffer FreeList {
    int count;
    int indices[];
} freelist;

layout(binding = 1, offset = 0) uniform atomic_uint activeParticleCount;

// Constants and uniforms
uniform vec3 globalForce = vec3(0, -9.8, 0);
uniform float sizeBegin;
uniform float sizeEnd;
uniform float deltaTime;
uniform float time;
uniform float mass;
uniform float buoyancy = 4.0;
uniform float airResistance = 0.12;
uniform float temperatureDecay = 180.0;
uniform float turbulenceScale = 0.8;
uniform vec3 windDirection;
uniform float windStrength;
uniform float baseVorticity = 2.5;
uniform float flickerSpeed = 3.0;
uniform float gasConstant;
uniform float restDensity;

// Grid parameters for spatial hashing
uniform float cellSize = 0.5; // Should be >= max smoothing length
uniform int gridResolution = 128; // Adjust based on simulation bounds

// Fast hash function for 3D coordinates
uint hash3D(ivec3 gridPos) 
{
    return uint(
        (gridPos.x * 73856093u) ^
        (gridPos.y * 19349663u) ^
        (gridPos.z * 83492791u)
    ) % uint(cellStarts.length());
}

// Get grid position from world position
ivec3 getGridPos(vec3 pos) 
{
    return ivec3(floor(pos / cellSize));
}

// 3D Simplex Noise (simplified version)
vec3 snoise(vec3 pos) 
{
    // Simplified noise for better performance
    vec3 p = floor(pos);
    vec3 f = fract(pos);
    f = f * f * (3.0 - 2.0 * f);
    
    float n = mix(
        mix(dot(sin(p), cos(p.yzx)), dot(sin(p + vec3(1,0,0)), cos((p + vec3(1,0,0)).yzx)), f.x),
        mix(dot(sin(p + vec3(0,1,0)), cos((p + vec3(0,1,0)).yzx)), dot(sin(p + vec3(1,1,0)), cos((p + vec3(1,1,0)).yzx)), f.x),
        f.y
    );
    
    return vec3(n) * 0.5;
}

// SPH kernel functions (optimized)
float poly6Kernel(float r2, float h) 
{
    float h2 = h * h;
    if (r2 >= h2) return 0.0;
    float factor = 315.0 / (64.0 * 3.14159265 * h2 * h2 * h2 * h2 * h);
    float diff = h2 - r2;
    return factor * diff * diff * diff;
}

vec3 spikyGradient(vec3 r, float rLen, float h) 
{
    if (rLen >= h || rLen == 0.0) return vec3(0.0);
    float factor = -45.0 / (3.14159265 * h * h * h * h * h * h);
    float diff = h - rLen;
    return factor * diff * diff * (r / rLen);
}

float viscosityLaplacian(float r, float h) 
{
    if (r >= h) return 0.0;
    return 45.0 / (3.14159265 * h * h * h * h * h * h) * (h - r);
}

vec3 getTurbulence(vec3 pos) 
{
    vec3 turb = snoise(pos * 0.5 + time) * 0.5;
    turb += snoise(pos * 2.0 + time * 1.3) * 0.25;
    return turb * turbulenceScale;
}

// Optimized SPH density calculation using spatial hashing
void calculateSPHDensityAndPressure(int index) 
{
    vec3 pos = positions[index].xyz;
    float h = smoothingLengths[index];
    float density = 0.0;
    
    ivec3 gridPos = getGridPos(pos);
    
    // Check 27 neighboring cells (3x3x3)
    for (int x = -1; x <= 1; x++) 
    {
        for (int y = -1; y <= 1; y++) 
        {
            for (int z = -1; z <= 1; z++) 
            {
                ivec3 neighborGrid = gridPos + ivec3(x, y, z);
                uint cellHash = hash3D(neighborGrid);
                
                int start = cellStarts[cellHash];
                int end = cellEnds[cellHash];
                if (start == end) 
                    continue; // Skip empty cells
                
                for (int i = start; i < end; i++) 
                {
                    if (i < 0 || i >= sortedIndices.length()) 
                        continue;
                    
                    int neighborIndex = int(sortedIndices[i]);
                    if (neighborIndex == index || velocities[neighborIndex].w <= 0.0)
                        continue;
                    
                    vec3 neighborPos = positions[neighborIndex].xyz;
                    vec3 diff = pos - neighborPos;
                    float r2 = dot(diff, diff);
                    
                    if (r2 < h * h) 
                    {
                        density += mass * poly6Kernel(r2, h);
                    }
                }
            }
        }
    }
    
    densities[index] = max(density, restDensity);
    pressures[index] = gasConstant * (densities[index] - restDensity);
}

// Optimized SPH force calculation
vec3 calculateSPHForces(int index) 
{
    vec3 pos = positions[index].xyz;
    vec3 vel = velocities[index].xyz;
    float h = smoothingLengths[index];
    float density = densities[index];
    float pressure = pressures[index];
    
    vec3 pressureForce = vec3(0.0);
    vec3 viscosityForce = vec3(0.0);
    vec3 thermalForce = vec3(0.0);
    
    ivec3 gridPos = getGridPos(pos);
    
    // Check neighboring cells
    for (int x = -1; x <= 1; x++) 
    {
        for (int y = -1; y <= 1; y++) 
        {
            for (int z = -1; z <= 1; z++) 
            {
                ivec3 neighborGrid = gridPos + ivec3(x, y, z);
                uint cellHash = hash3D(neighborGrid);
                
                int start = cellStarts[cellHash];
                int end = cellEnds[cellHash];
                
                for (int i = start; i < end; i++)
                {
                    if (i < 0 || i >= sortedIndices.length()) continue;
                    
                    int neighborIndex = int(sortedIndices[i]);
                    if (neighborIndex == index || velocities[neighborIndex].w <= 0.0) 
                        continue;
                    
                    vec3 neighborPos = positions[neighborIndex].xyz;
                    vec3 neighborVel = velocities[neighborIndex].xyz;
                    float neighborDensity = densities[neighborIndex];
                    float neighborPressure = pressures[neighborIndex];
                    float neighborTemp = temperatures[neighborIndex];
                    
                    vec3 r = pos - neighborPos;
                    float rLen = length(r);
                    
                    if (rLen < h && rLen > 0.0) 
                    {
                        // Pressure force
                        vec3 gradient = spikyGradient(r, rLen, h);
                        pressureForce -= mass * (pressure + neighborPressure) / (2.0 * neighborDensity) * gradient;
                        
                        // Viscosity force (reduced for fire)
                        float viscosity = 0.1;
                        viscosityForce += mass * viscosity * (neighborVel - vel) / neighborDensity * viscosityLaplacian(rLen, h);
                        
                        // Thermal buoyancy interaction
                        float tempDiff = neighborTemp - temperatures[index];
                        if (tempDiff > 0.0) 
                        {
                            thermalForce += (r / rLen) * tempDiff * 0.001;
                        }
                    }
                }
            }
        }
    }
    
    return (pressureForce + viscosityForce + thermalForce) / density;
}

// Optimized neighbor heat influence calculation
float calculateNeighborHeatInfluence(int index) 
{
    vec3 pos = positions[index].xyz;
    float h = smoothingLengths[index];
    float neighborHeatInfluence = 0.0;
    int hotNeighbors = 0;
    
    ivec3 gridPos = getGridPos(pos);
    
    // Only check immediate neighbors for heat influence
    for (int x = -1; x <= 1 && hotNeighbors < 8; x++) 
    {
        for (int y = -1; y <= 1 && hotNeighbors < 8; y++) 
        {
            for (int z = -1; z <= 1 && hotNeighbors < 8; z++) 
            {
                ivec3 neighborGrid = gridPos + ivec3(x, y, z);
                uint cellHash = hash3D(neighborGrid);
                
                int start = cellStarts[cellHash];
                int end = cellEnds[cellHash];
                
                for (int i = start; i < end && hotNeighbors < 8; i++) 
                {
                    if (i < 0 || i >= sortedIndices.length()) 
                        continue;
                    
                    int neighborIndex = int(sortedIndices[i]);
                    if (neighborIndex == index || velocities[neighborIndex].w <= 0.0) continue;
                    
                    vec3 neighborPos = positions[neighborIndex].xyz;
                    float distance = length(pos - neighborPos);
                    
                    if (distance < h) 
                    {
                        if (temperatures[neighborIndex] > temperatures[index]) 
                        {
                            neighborHeatInfluence += (temperatures[neighborIndex] - temperatures[index]) * 0.1;
                            hotNeighbors++;
                        }
                    }
                }
            }
        }
    }
    
    return neighborHeatInfluence;
}

void updateParticle(int index) 
{
    // Lifetime management
    velocities[index].w -= deltaTime;
    if(velocities[index].w <= 0.0) 
    {
        int idx = atomicAdd(freelist.count, 1);
        freelist.indices[idx] = index;
        return;
    }
    atomicCounterIncrement(activeParticleCount);

    // Calculate SPH properties
    calculateSPHDensityAndPressure(index);
    vec3 sphForces = calculateSPHForces(index);

    // Age calculations
    float age = 1.0 - (velocities[index].w / lifespans[index]);
    float tempFactor = temperatures[index] / 2500.0;

    // Physics forces
    vec3 acceleration = globalForce * mass;
    acceleration.y += buoyancy * tempFactor;
    
    // Add SPH forces (scaled for stability)
    acceleration += sphForces * 0.5;
    
    // Wind and turbulence
    vec3 wind = windDirection * windStrength;
    vec3 turbulence = getTurbulence(positions[index].xyz);
    acceleration += wind + turbulence;
    
    // Velocity integration
    velocities[index].xyz += acceleration * deltaTime;
    velocities[index].xyz *= exp(-airResistance * deltaTime);
    positions[index].xyz += velocities[index].xyz * deltaTime;

    // Temperature cooling with neighbor influence
    float tempCooling = temperatureDecay * deltaTime * (1.0 + age * 2.0);
    float neighborHeatInfluence = calculateNeighborHeatInfluence(index);
    
    temperatures[index] = max(temperatures[index] - tempCooling + neighborHeatInfluence * deltaTime, 0.0);

    // Size evolution
    positions[index].w = mix(sizeEnd, sizeBegin, 1.0 - age * age);

    // Smoke generation
    smokeAmounts[index] = smoothstep(0.5, 0.9, age) * (1.0 - tempFactor);
}

void main() 
{
    uint id = gl_GlobalInvocationID.x;
    if(id >= positions.length()) 
        return;
    if(velocities[id].w <= 0.0) 
        return;

    updateParticle(int(id));
}