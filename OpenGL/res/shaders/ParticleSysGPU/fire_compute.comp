// fireCompute.comp: Compute shader for updating particles for fire simulation
#version 430 core
layout(local_size_x = 256) in;

struct Particle 
{
    vec4 position;
    vec4 velocity;
    vec4 colorBegin;
    vec4 colorEnd;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer FreeListBuffer {
    int count;
    int indices[];
} freelist;

layout(binding = 1, offset = 0) uniform atomic_uint activeParticleCount;

uniform float deltaTime;
uniform vec3 globalForce = vec3(0.0, -9.8, 0.0);
uniform float sizeBegin;
uniform float sizeEnd;
uniform float mass;

float dragCoefficient = 0.47;
float airDensity = 1.225;
float particleSize = 0.1;

vec3 wobbleEffect(Particle p, float amp, float freq)
{
    float lifespan = p.colorEnd.w;
    float lifeRemaining = p.velocity.w;
    float lifePercent = lifeRemaining / lifespan;
    float lifeFactor = 1.0 - lifePercent;
    float offsetX = amp * sin((freq + lifeFactor) * lifeRemaining);
    float offsetZ = amp * cos((freq + lifeFactor) * lifeRemaining);

    return vec3(p.position.x + offsetX, p.position.y, p.position.z + offsetZ);
}

void UpdateParticle(inout Particle particle, int index)
{
    particle.velocity.w -= deltaTime;
    
    // If particle just died, add to free list and return
    if (particle.velocity.w <= 0.0) 
    {
        int idx = atomicAdd(freelist.count, 1);
        // Ensure we don't overflow the free list
        if (idx < freelist.indices.length()) 
        {
            freelist.indices[idx] = index;
        }
        return;
    }

    atomicCounterIncrement(activeParticleCount);

    float lifespan = particle.colorEnd.w;
    float lifeRemaining = particle.velocity.w;
    float lifePercent = lifeRemaining / lifespan;
    
    particle.position.w = mix(sizeEnd, sizeBegin, lifePercent);
    
    // Gravity (pulls downward)
    vec3 gravityForce = globalForce * mass;
    
    // Buoyancy (pushes upward, decreases over lifetime)
    float heatFactor = (1.0 - lifePercent) * 2.0;
    vec3 buoyancyForce = vec3(0.0, 8.0 * heatFactor, 0.0);
    
    // Drag (opposes motion)
    float crossSectionalArea = 3.1415 * particleSize * particleSize;
    vec3 dragForce = -0.5 * dragCoefficient * airDensity * crossSectionalArea * length(particle.velocity.xyz) * normalize(particle.velocity.xyz);
    
    // Turbulence (adds randomness)
    float turbulenceStrength = 2.0 * (1.0 - lifePercent);
    float noiseX = sin(lifeRemaining * 10.0 + particle.position.x * 5.0);
    float noiseZ = cos(lifeRemaining * 8.0 + particle.position.z * 4.0);
    vec3 turbulenceForce = vec3(turbulenceStrength * noiseX, 0.0f, turbulenceStrength * noiseZ);
    
    // Total force applied
    vec3 totalForce = gravityForce + buoyancyForce + dragForce + turbulenceForce;
    
    // Calculate outward direction in XZ plane
    vec3 outwardDir = normalize(vec3(particle.position.x, 0.0, particle.position.z));

    // Compute an inward pull effect
    float lifeProgress = 1.0 - lifePercent;
    float inwardForceStrength = smoothstep(0.2, 1.0, lifeProgress); // No inward force initially
    totalForce -= inwardForceStrength * outwardDir * 0.5;
    //float inwardForce = (1.0f - lifePercent) * 0.15f;
    //totalForce.x += -particle.position.x * inwardForce;
    //totalForce.z += -particle.position.z * inwardForce;



    // Apply total force to velocity
    particle.velocity.xyz += totalForce * deltaTime;
    particle.position.xyz += particle.velocity.xyz * deltaTime;
    //particle.position.xyz = wobbleEffect(particle, 0.5, 2.0);
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= particles.length())
        return;

    if (particles[id].velocity.w <= 0.0)
            return;

    UpdateParticle(particles[id], int(id));
}