// fireCompute.comp: Compute shader for updating particles for fire simulation
#version 430 core
layout(local_size_x = 256) in;

struct FireParticle  
{
    vec4 position;    // xyz = position, w = size
    vec4 velocity;    // xyz = velocity, w = remaining lifetime
    vec4 colorBegin;  // rgb = color, a = opacity
    vec4 colorEnd;    // rgb = end color, w = total lifespan
    float temperature; // particle temperature in Kelvin
    float smokeAmount; // 0-1 value for smoke transition
};

layout(std430, binding = 0) buffer ParticleBuffer {
    FireParticle particles[];
};

layout(std430, binding = 1) buffer FreeListBuffer {
    int count;
    int indices[];
} freelist;

layout(binding = 1, offset = 0) uniform atomic_uint activeParticleCount;

uniform float deltaTime;
uniform float time;
uniform float sizeBegin;
uniform float sizeEnd;
uniform vec3 globalForce = vec3(0.0, -9.8, 0.0);

uniform vec3 windDirection;
uniform float windStrength;
uniform float mass;

float dragCoefficient = 0.47;
float airDensity = 1.225;
float particleSize = 0.1;

vec3 wobbleEffect(FireParticle p, float amp, float freq)
{
    float lifespan = p.colorEnd.w;
    float lifeRemaining = p.velocity.w;
    float lifePercent = lifeRemaining / lifespan;
    float lifeFactor = 1.0 - lifePercent;
    float offsetX = amp * sin((freq + lifeFactor) * lifeRemaining);
    float offsetZ = amp * cos((freq + lifeFactor) * lifeRemaining);

    return vec3(p.position.x + offsetX, p.position.y, p.position.z + offsetZ);
}

vec3 hash(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}

// Simplex noise function
float noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    
    vec3 u = f * f * (3.0 - 2.0 * f);
    
    return mix(mix(mix(dot(hash(i + vec3(0.0, 0.0, 0.0)), f - vec3(0.0, 0.0, 0.0)),
                       dot(hash(i + vec3(1.0, 0.0, 0.0)), f - vec3(1.0, 0.0, 0.0)), u.x),
                   mix(dot(hash(i + vec3(0.0, 1.0, 0.0)), f - vec3(0.0, 1.0, 0.0)),
                       dot(hash(i + vec3(1.0, 1.0, 0.0)), f - vec3(1.0, 1.0, 0.0)), u.x), u.y),
               mix(mix(dot(hash(i + vec3(0.0, 0.0, 1.0)), f - vec3(0.0, 0.0, 1.0)),
                       dot(hash(i + vec3(1.0, 0.0, 1.0)), f - vec3(1.0, 0.0, 1.0)), u.x),
                   mix(dot(hash(i + vec3(0.0, 1.0, 1.0)), f - vec3(0.0, 1.0, 1.0)),
                       dot(hash(i + vec3(1.0, 1.0, 1.0)), f - vec3(1.0, 1.0, 1.0)), u.x), u.y), u.z);
}

// Curl noise for realistic turbulence
vec3 curlNoise(vec3 p, float time) 
{
    const float epsilon = 0.001;
    float n1, n2;
    vec3 curl = vec3(0.0);
    
    // Calculate curl for X component
    n1 = noise(p + vec3(0.0, epsilon, 0.0) + time * 0.1);
    n2 = noise(p + vec3(0.0, -epsilon, 0.0) + time * 0.1);
    curl.x = (n1 - n2) / (2.0 * epsilon);
    
    n1 = noise(p + vec3(0.0, 0.0, epsilon) + time * 0.1);
    n2 = noise(p + vec3(0.0, 0.0, -epsilon) + time * 0.1);
    curl.x -= (n1 - n2) / (2.0 * epsilon);
    
    // Calculate curl for Y component
    n1 = noise(p + vec3(0.0, 0.0, epsilon) + time * 0.1);
    n2 = noise(p + vec3(0.0, 0.0, -epsilon) + time * 0.1);
    curl.y = (n1 - n2) / (2.0 * epsilon);
    
    n1 = noise(p + vec3(epsilon, 0.0, 0.0) + time * 0.1);
    n2 = noise(p + vec3(-epsilon, 0.0, 0.0) + time * 0.1);
    curl.y -= (n1 - n2) / (2.0 * epsilon);
    
    // Calculate curl for Z component
    n1 = noise(p + vec3(epsilon, 0.0, 0.0) + time * 0.1);
    n2 = noise(p + vec3(-epsilon, 0.0, 0.0) + time * 0.1);
    curl.z = (n1 - n2) / (2.0 * epsilon);
    
    n1 = noise(p + vec3(0.0, epsilon, 0.0) + time * 0.1);
    n2 = noise(p + vec3(0.0, -epsilon, 0.0) + time * 0.1);
    curl.z -= (n1 - n2) / (2.0 * epsilon);
    
    return curl;
}

