#version 430 core

layout(local_size_x = 256) in;

struct Particle 
{
    vec4 position;    // xyz = position, w = size
    vec4 velocity;    // xyz = velocity, w = lifeRemaining
    vec4 colorBegin;
    vec4 colorEnd;    // w = lifespan
    float mass;
    float initialPhase;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer FreeListBuffer {
    int count;
    int indices[];
} freelist;

layout(binding = 1, offset = 0) uniform atomic_uint activeParticleCount;

uniform float deltaTime;
uniform vec3 globalForce;
uniform float sizeBegin;
uniform float sizeEnd;

void UpdateParticle(inout Particle particle, int index)
{
    if (particle.velocity.w > 0)
    {
        // Check if particle is active
        if (particle.velocity.w <= 0.0)
            return;

        particle.velocity.w -= deltaTime;

        // Apply global force to velocity
        particle.velocity.xyz += globalForce * deltaTime;


        particle.position.xyz += particle.velocity.xyz * deltaTime;
        float lifespan = particle.colorEnd.w;
        float lifeRemaining = particle.velocity.w;
        float lifePercent = lifeRemaining / lifespan;
        particle.position.w = mix(sizeEnd, sizeBegin, lifePercent);

         atomicCounterIncrement(activeParticleCount);

         if (particle.velocity.w <= 0.0) 
         {
            int idx = atomicAdd(freelist.count, 1);
            if (idx < freelist.indices.length()) 
            {
                freelist.indices[idx] = index;
            }
         }
    }
    
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= particles.length())
        return;

    UpdateParticle(particles[id], int(id));
}