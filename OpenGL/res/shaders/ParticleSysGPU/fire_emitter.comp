// fire_emitter.comp: Compute shader for emitting new fire particles
#version 430 core
layout(local_size_x = 256) in;

struct FireParticle  
{
    vec4 position;    // xyz = position, w = size
    vec4 velocity;    // xyz = velocity, w = remaining lifetime
    vec4 colorBegin;  // rgb = color, a = opacity
    vec4 colorEnd;    // rgb = end color, w = total lifespan
    float temperature; // particle temperature in Kelvin
    float smokeAmount; // 0-1 value for smoke transition
};

layout(binding = 0) uniform atomic_uint newParticleCounter;
layout(std430, binding = 0) buffer ParticleBuffer {
    FireParticle particles[];
};

layout(std430, binding = 1) buffer FreeListBuffer {
    int count;
    int indices[];
} freelist;

// Emission parameters
uniform int newParticleCount;
uniform vec3 emitterPosition;
uniform vec3 emitterRotation;
uniform float emitterRadius;
uniform float emitterAngle;
uniform int emitterShape;


uniform vec4 particleColorBegin;
uniform vec4 particleColorEnd;
uniform float particleLifespan;
uniform float particleSizeBegin;
uniform float time;

uniform float minTemperature;
uniform float maxTemperature;

// Random number generation
uint seed = 0;
uint wang_hash(uint seed) 
{
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

float rand() 
{
    seed = wang_hash(seed);
    return float(seed) / 4294967296.0;
}

vec3 randomInUnitDisk()
{
    float t = rand() * 2.0 * 3.14159265;
    float r = sqrt(rand());
    float x = r * cos(t);
    float z = r * sin(t);
    return vec3(x, 0.0, z);
}

// Utility functions for different emitter shapes
vec3 generatePointPosition() 
{
    return emitterPosition;
}

vec3 generateCirclePosition() 
{
    // Generate a point on a unit circle
    float theta = rand() * 2.0 * 3.14159265;
    
    float radiusX = emitterRadius;
    
    // Random distance from center (using sqrt for uniform distribution)
    float distance = sqrt(rand());
    
    // Convert to cartesian coordinates with elliptical distortion
    float x = distance * radiusX * cos(theta);
    float y = 0.0; // Usually fire emits from a flat surface
    float z = distance * radiusX * sin(theta);
    
    // Apply emitter rotation
    mat3 rotX = mat3(
        1, 0, 0,
        0, cos(radians(emitterRotation.x)), -sin(radians(emitterRotation.x)),
        0, sin(radians(emitterRotation.x)), cos(radians(emitterRotation.x))
    );
    
    mat3 rotY = mat3(
        cos(radians(emitterRotation.y)), 0, sin(radians(emitterRotation.y)),
        0, 1, 0,
        -sin(radians(emitterRotation.y)), 0, cos(radians(emitterRotation.y))
    );
    
    mat3 rotZ = mat3(
        cos(radians(emitterRotation.z)), -sin(radians(emitterRotation.z)), 0,
        sin(radians(emitterRotation.z)), cos(radians(emitterRotation.z)), 0,
        0, 0, 1
    );
    
    vec3 rotatedOffset = rotZ * rotY * rotX * vec3(x, y, z);
    return emitterPosition + rotatedOffset;
}

vec3 generateVelocity(vec3 position)
{
    vec3 dir;
    // Calculate distance from center
    vec2 horizOffset = vec2(position.x - emitterPosition.x, position.z - emitterPosition.z);
    float distFromCenter = length(horizOffset);
    
    // Normalize horizontal offset for directional component
    vec2 normHorizOffset = distFromCenter > 0.0001 ? horizOffset / distFromCenter : vec2(0.0);
    
    // Particles closer to the center should move more directly upward
    // Particles at the edges should curl slightly inward
    float centerFactor = smoothstep(0.0, emitterRadius, distFromCenter);
    
    // Base upward direction
    vec3 baseDir = vec3(0.0, 1.0, 0.0);
    
    // Add slight inward curl at the edges
    vec3 inwardCurl = vec3(-normHorizOffset.x * 0.2, 0.0, -normHorizOffset.y * 0.2);
    
    // Particles at the edges move more slowly upward
    float speedFactor = mix(1.0, 0.7, centerFactor);
    
    // Combine directions
    dir = normalize(baseDir + inwardCurl * centerFactor);
    
    // Add slight randomness that increases with height
    // This creates the flame "licking" effect
    float heightRandomness = 0.15 + (position.y - emitterPosition.y) * 0.05;
    dir = normalize(dir + vec3(
        (rand() * 2.0 - 1.0) * heightRandomness,
        rand() * 0.05,  // Small random upward component
        (rand() * 2.0 - 1.0) * heightRandomness
    ));
    
    // Adjust speed based on position
    float speed = mix(2.0, 3.5, rand()) * speedFactor;
    return dir * speed;
}

void EmitParticle(int particleIndex)
{
    // Initialize random seed based on particle index and time
    seed = uint(particleIndex) + uint(time * 10000.0);
    
    // Get particle to initialize
    FireParticle particle = particles[particleIndex];
    
    // Set position - distribute across emitter disk
    vec3 posOffset = randomInUnitDisk() * emitterRadius;
    particle.position.xyz = generateCirclePosition();
    
    // Randomize particle size
    particle.position.w = particleSizeBegin;
    
    // Set initial upward velocity with some randomness
    particle.velocity.xyz = generateVelocity(particle.position.xyz);
    
    // Set lifetime
    particle.velocity.w = particleLifespan;  // Remaining lifetime
    particle.colorEnd.w = particleLifespan;  // Total lifespan
    
    // Set colors
    particle.colorBegin = particleColorBegin;
    particle.colorEnd.rgb = particleColorEnd.rgb;
    
    // Set initial temperature - hotter near center
    float distFromCenter = length(posOffset) / emitterRadius;
    float tempRandom = rand() * 0.2 - 0.1; // ±10% randomness
    float temp = mix(maxTemperature, minTemperature, distFromCenter) * (1.0 + tempRandom);
    particle.temperature = temp;
    
    // Initialize smoke amount to zero (pure flame)
    particle.smokeAmount = 0.0;
    
    // Write back to buffer
    particles[particleIndex] = particle;
}

void main()
{
    // Each thread handles one potential new particle
    uint id = gl_GlobalInvocationID.x;
    
    // Only proceed if within the number of new particles to create
    if (id >= newParticleCount)
        return;

    int freeListIndex = atomicAdd(freelist.count, -1) - 1;
    if (freeListIndex < 0) 
    {
        atomicAdd(freelist.count, 1);
        return;
    }

    // Get an index in the particle array using atomic counter
    uint particleIndex = freelist.indices[freeListIndex];
    
    // Initialize seed based on particle index and global time
    seed = uint(particleIndex) + gl_GlobalInvocationID.x * 1973 + 
           uint(sin(float(id)) * 43758.5453);
    
    // Generate position based on emitter shape
    vec3 position = generateCirclePosition();
    vec3 velocity = generateVelocity(position);

    // Set initial temperature - hotter near center
    float distFromCenter = length(position) / emitterRadius;
    float tempRandom = rand() * 0.2 - 0.1; // ±10% randomness
    float temp = mix(maxTemperature, minTemperature, distFromCenter) * (1.0 + tempRandom);
    
    // Set particle properties
    particles[particleIndex].position = vec4(position, particleSizeBegin);
    particles[particleIndex].velocity = vec4(velocity, particleLifespan);
    particles[particleIndex].colorBegin = particleColorBegin;
    particles[particleIndex].colorEnd = vec4(particleColorEnd.rgb, particleLifespan);
    particles[particleIndex].temperature = temp;
    particles[particleIndex].smokeAmount = 0.0;
}