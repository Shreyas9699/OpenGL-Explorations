// Emitter compute shader
#version 430 core
layout(local_size_x = 256) in;

struct Particle 
{
    vec4 position;    // xyz = position, w = size
    vec4 velocity;    // xyz = velocity, w = lifeRemaining
    vec4 colorBegin;
    vec4 colorEnd;    // w = lifespan
};

// Particle storage buffer
layout(binding = 0) uniform atomic_uint newParticleCounter;
layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer FreeListBuffer {
    int count;
    int indices[];
} freelist;


// Emitter properties
uniform int newParticleCount;
uniform vec3 emitterPosition;
uniform vec3 emitterRotation;
uniform vec3 emitterDimensions;
uniform float emitterRadius;
uniform float emitterAngle;
uniform int emitterShape; // 0=POINT, 1=SPHERE, 2=CONE, 3=BOX
uniform vec3 lineStart;
uniform vec3 lineEnd;
uniform float torusInnerRadius;
uniform float torusOuterRadius;

// Particle properties
uniform float particleLifespan;
uniform float particleSizeBegin;
uniform vec4 particleColorBegin;
uniform vec4 particleColorEnd;

// Random number generation
uint seed = 0;
uint wang_hash(uint seed) 
{
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

float rand() 
{
    seed = wang_hash(seed);
    return float(seed) / 4294967296.0;
}

// Utility functions for different emitter shapes
vec3 generatePointPosition() 
{
    return emitterPosition;
}

vec3 generateSpherePosition() 
{
    float u = rand();
    float v = rand();
    float theta = 2.0 * 3.14159265 * u;  // Uniform theta
    float phi = acos(2.0 * v - 1.0);      // Proper phi distribution
    
    float x = sin(phi) * cos(theta);
    float y = sin(phi) * sin(theta);
    float z = cos(phi);
    
    float r = emitterRadius * pow(rand(), 1.0/3.0);
    return emitterPosition + vec3(x, y, z) * r;
}

vec3 generateConePosition() 
{
    float theta = rand() * 2.0 * 3.14159265;
    float distance = rand() * emitterRadius;
    
    float spread = radians(emitterAngle);
    float phi = rand() * spread;
    
    float x = distance * sin(phi) * cos(theta);
    float y = distance * sin(phi) * sin(theta);
    float z = distance * cos(phi);
    
    // Apply emitter rotation
    mat3 rotX = mat3(
        1, 0, 0,
        0, cos(radians(emitterRotation.x)), -sin(radians(emitterRotation.x)),
        0, sin(radians(emitterRotation.x)), cos(radians(emitterRotation.x))
    );
    
    mat3 rotY = mat3(
        cos(radians(emitterRotation.y)), 0, sin(radians(emitterRotation.y)),
        0, 1, 0,
        -sin(radians(emitterRotation.y)), 0, cos(radians(emitterRotation.y))
    );
    
    mat3 rotZ = mat3(
        cos(radians(emitterRotation.z)), -sin(radians(emitterRotation.z)), 0,
        sin(radians(emitterRotation.z)), cos(radians(emitterRotation.z)), 0,
        0, 0, 1
    );
    
    vec3 rotatedOffset = rotZ * rotY * rotX * vec3(x, y, z);
    return emitterPosition + rotatedOffset;
}

vec3 generateBoxPosition() 
{
    float x = (rand() * 2.0 - 1.0) * emitterDimensions.x * 0.5;
    float y = (rand() * 2.0 - 1.0) * emitterDimensions.y * 0.5;
    float z = (rand() * 2.0 - 1.0) * emitterDimensions.z * 0.5;
    
    // Apply emitter rotation
    mat3 rotX = mat3(
        1, 0, 0,
        0, cos(radians(emitterRotation.x)), -sin(radians(emitterRotation.x)),
        0, sin(radians(emitterRotation.x)), cos(radians(emitterRotation.x))
    );
    
    mat3 rotY = mat3(
        cos(radians(emitterRotation.y)), 0, sin(radians(emitterRotation.y)),
        0, 1, 0,
        -sin(radians(emitterRotation.y)), 0, cos(radians(emitterRotation.y))
    );
    
    mat3 rotZ = mat3(
        cos(radians(emitterRotation.z)), -sin(radians(emitterRotation.z)), 0,
        sin(radians(emitterRotation.z)), cos(radians(emitterRotation.z)), 0,
        0, 0, 1
    );
    
    vec3 rotatedOffset = rotZ * rotY * rotX * vec3(x, y, z);
    return emitterPosition + rotatedOffset;
}

vec3 generateCirclePosition() 
{
    // Generate a point on a unit circle
    float theta = rand() * 2.0 * 3.14159265;
    
    float radiusX = emitterRadius;
    
    // Random distance from center (using sqrt for uniform distribution)
    float distance = sqrt(rand());
    
    // Convert to cartesian coordinates with elliptical distortion
    float x = distance * radiusX * cos(theta);
    float y = 0.0; // Usually fire emits from a flat surface
    float z = distance * radiusX * sin(theta);
    
    // Apply emitter rotation
    mat3 rotX = mat3(
        1, 0, 0,
        0, cos(radians(emitterRotation.x)), -sin(radians(emitterRotation.x)),
        0, sin(radians(emitterRotation.x)), cos(radians(emitterRotation.x))
    );
    
    mat3 rotY = mat3(
        cos(radians(emitterRotation.y)), 0, sin(radians(emitterRotation.y)),
        0, 1, 0,
        -sin(radians(emitterRotation.y)), 0, cos(radians(emitterRotation.y))
    );
    
    mat3 rotZ = mat3(
        cos(radians(emitterRotation.z)), -sin(radians(emitterRotation.z)), 0,
        sin(radians(emitterRotation.z)), cos(radians(emitterRotation.z)), 0,
        0, 0, 1
    );
    
    vec3 rotatedOffset = rotZ * rotY * rotX * vec3(x, y, z);
    return emitterPosition + rotatedOffset;
}

vec3 generateTorusPosition() 
{
    float angle1 = rand() * 2.0 * 3.14159265;  // Angle around main torus loop
    float angle2 = rand() * 2.0 * 3.14159265;  // Angle around the minor ring
    
    float majorRadius = torusOuterRadius;
    float minorRadius = torusInnerRadius + rand() * (torusOuterRadius - torusInnerRadius);
    
    float x = (majorRadius + minorRadius * cos(angle2)) * cos(angle1);
    float y = minorRadius * sin(angle2);
    float z = (majorRadius + minorRadius * cos(angle2)) * sin(angle1);
    
    return emitterPosition + vec3(x, y, z);
}

vec3 generateHemispherePosition() 
{
    float u = rand();
    float v = rand();
    float theta = 2.0 * 3.14159265 * u;
    float phi = acos(v); // Restrict to upper hemisphere (0 to pi/2)
    
    float x = sin(phi) * cos(theta);
    float y = sin(phi) * sin(theta);
    float z = cos(phi);
    
    float r = emitterRadius * pow(rand(), 1.0/3.0); // Uniform distribution
    
    return emitterPosition + vec3(x, abs(y), z) * r; // Only positive Y values
}

// Generate velocity based on emitter shape
vec3 generateVelocity(vec3 position) 
{
    vec3 dir;
    
    switch(emitterShape) 
    {
        case 0: // POINT
            // Random direction
            {
                float theta = rand() * 2.0 * 3.14159265;
                float phi = rand() * 3.14159265;
                dir = vec3(
                    sin(phi) * cos(theta),
                    sin(phi) * sin(theta),
                    cos(phi)
                );
            }
            break;
            
        case 1: // SPHERE
            // Outward from center
            dir = normalize(position - emitterPosition);
            if (length(dir) < 0.0001) 
            {
                float theta = rand() * 2.0 * 3.14159265;
                float phi = rand() * 3.14159265;
                dir = vec3(
                    sin(phi) * cos(theta),
                    sin(phi) * sin(theta),
                    cos(phi)
                );
            }
            break;

        case 2: // CONE
            // Within cone angle
            {
                float theta = rand() * 2.0 * 3.14159265;
                float spread = radians(emitterAngle);
                float phi = rand() * spread;
                
                float x = sin(phi) * cos(theta);
                float y = sin(phi) * sin(theta);
                float z = cos(phi);
                
                // Apply emitter rotation
                mat3 rotX = mat3(
                    1, 0, 0,
                    0, cos(radians(emitterRotation.x)), -sin(radians(emitterRotation.x)),
                    0, sin(radians(emitterRotation.x)), cos(radians(emitterRotation.x))
                );
                
                mat3 rotY = mat3(
                    cos(radians(emitterRotation.y)), 0, sin(radians(emitterRotation.y)),
                    0, 1, 0,
                    -sin(radians(emitterRotation.y)), 0, cos(radians(emitterRotation.y))
                );
                
                mat3 rotZ = mat3(
                    cos(radians(emitterRotation.z)), -sin(radians(emitterRotation.z)), 0,
                    sin(radians(emitterRotation.z)), cos(radians(emitterRotation.z)), 0,
                    0, 0, 1
                );
                
                dir = normalize(rotZ * rotY * rotX * vec3(x, y, z));
            }
            break;
            
        case 3: // BOX
            // Outward from center
            dir = normalize(position - emitterPosition);
            if (length(dir) < 0.0001) 
            {
                dir = normalize(vec3(
                    rand() * 2.0 - 1.0,
                    rand() * 2.0 - 1.0,
                    rand() * 2.0 - 1.0
                ));
            }
            break;

        case 4: // CIRCLE
            {
                // Generate random angle
                float theta = rand() * 2.0 * 3.14159265;
                
                // Outward direction in XZ plane
                dir = normalize(vec3(cos(theta), 0.0, sin(theta)));
                
                // Optional: Add slight randomness
                float randomness = 0.1;  // Adjust for more/less randomness
                dir += vec3(
                    (rand() * 2.0 - 1.0) * randomness,
                    0.0, // No Y deviation
                    (rand() * 2.0 - 1.0) * randomness
                );
                
                dir = normalize(dir); // Normalize after adding randomness
            }
            break;

        case 5: // HEMISPHERE
            dir = normalize(position - emitterPosition);
            if (dir.y < 0) dir.y *= -1.0; // Only emit upwards
            break;

        case 6: // TORUS
            {
                float angle = rand() * 2.0 * 3.14159265;
                float radius = torusInnerRadius + rand() * (torusOuterRadius - torusInnerRadius);
                float x = radius * cos(angle);
                float z = radius * sin(angle);
                dir = normalize(vec3(x, 0, z));  // Emit outward from ring
            }
            break;

        default:
            dir = vec3(0.0, 1.0, 0.0);
    }
    
    // Add some randomness to velocity
    float speed = 2.0 + rand() * 3.0;
    return dir * speed;
}

void main() 
{
    // Each thread handles one potential new particle
    uint id = gl_GlobalInvocationID.x;
    
    // Only proceed if within the number of new particles to create
    if (id >= newParticleCount)
        return;

    int freeListIndex = atomicAdd(freelist.count, -1) - 1;
    if (freeListIndex <= 0) 
    {
        atomicAdd(freelist.count, 1);
        return;
    }

    
    // Get an index in the particle array using atomic counter
    uint particleIndex = freelist.indices[freeListIndex];
    
    // Initialize seed based on particle index and global time
    seed = uint(particleIndex) + gl_GlobalInvocationID.x * 1973 + 
           uint(sin(float(id)) * 43758.5453);
    
    // Generate position based on emitter shape
    vec3 position;
    switch(emitterShape) 
    {
        case 0: position = generatePointPosition(); break;
        case 1: position = generateSpherePosition(); break;
        case 2: position = generateConePosition(); break;
        case 3: position = generateBoxPosition(); break;
        case 4: position = generateCirclePosition(); break;
        case 5: position = generateHemispherePosition(); break;
        case 6: position = generateTorusPosition(); break;
        default: position = generatePointPosition();
    }
    
    // Generate velocity based on position and shape
    vec3 velocity = generateVelocity(position);
    
    // Create the new particle
    particles[particleIndex].position = vec4(position, particleSizeBegin);
    particles[particleIndex].velocity = vec4(velocity, particleLifespan);
    particles[particleIndex].colorBegin = particleColorBegin;
    particles[particleIndex].colorEnd = vec4(particleColorEnd.rgb, particleLifespan);
}